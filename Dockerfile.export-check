# Optional clean-machine verification; exported games do not require Docker.
FROM archlinux:base
RUN pacman -Syu --noconfirm --needed \
    libglvnd libxkbcommon dbus glib2 fontconfig wayland ttf-dejavu libseccomp \
    bzip2 expat libffi openssl sqlite gdbm readline ncurses libnsl xz tar \
    && pacman -Scc --noconfirm \
    && useradd --create-home forge
USER forge
WORKDIR /tmp
ENV QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME=""
